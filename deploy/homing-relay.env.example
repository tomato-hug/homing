# Homing 中继服务环境变量（复制到 /etc/homing-relay.env）
#   sudo install -m 600 -o root -g root deploy/homing-relay.env.example /etc/homing-relay.env
# 本文件只含占位符，真实凭据请在服务器上填写，切勿提交到 Git。

# ---------------------------------------------------------------
# 1. 认证与注册
# ---------------------------------------------------------------
# managed = 公共中继：电脑端需在 /account 获取 hrk_... 密钥，手机扫码配对即可
# open    = 自建免注册：不需要账号（个人或团队内网推荐）
HOMING_AUTH_MODE=managed

# 新用户注册策略：open（开放注册）| invite（需邀请码/兑换码）| closed（只允许老用户登录）
# 上线后可在 /admin 或桌面端管理台随时切换，无需重启。
HOMING_REGISTRATION_MODE=open

# 管理员令牌：登录 /admin 与桌面端「管理员：中继节点与账号管理台」。
# 用 `openssl rand -hex 32` 生成；为空时管理后台关闭。
HOMING_ADMIN_TOKEN=REPLACE_WITH_OPENSSL_RAND_HEX_32

# 反向代理来源（本机 Nginx）。用于识别真实客户端 IP 做限流。
HOMING_TRUSTED_PROXIES=127.0.0.1,::1

# 对外访问的 HTTPS 根地址（GitHub OAuth 回调与展示地址）
HOMING_PUBLIC_BASE_URL=https://relay.example.com

# ---------------------------------------------------------------
# 2. 免费用户额度（防止服务器过载）
# ---------------------------------------------------------------
# 每周远程使用时长（分钟）：只统计「手机主动发出请求」的分钟数，
# 电脑在线、心跳保活和推送到手机都不计时。默认 1200 = 20 小时，0 = 不限。
# 每周一 00:00（北京时间）重置。单个账号可在 /admin 单独调整。
HOMING_FREE_WEEKLY_MINUTES=1200
# 赞助用户每周时长，0 = 不限
HOMING_SPONSOR_WEEKLY_MINUTES=0
# 其余固定额度（Free / Sponsor）：电脑 2/8 台、手机 4/20 台、
# 单条消息 512 KB / 25 MB、每日流量 64 MB / 2 GB（UTC 0 点重置）。

# ---------------------------------------------------------------
# 3. 邮箱验证码登录（SMTP）—— 与 GitHub 登录至少配置一种
# ---------------------------------------------------------------
# 阿里云邮件推送 smtpdm.aliyun.com:465 / 腾讯企业邮 smtp.exmail.qq.com:465
# QQ 邮箱 smtp.qq.com:465（需授权码）/ 网易企业邮 smtphz.qiye.163.com:465
HOMING_SMTP_HOST=
HOMING_SMTP_PORT=465
HOMING_SMTP_USER=
HOMING_SMTP_PASS=
HOMING_SMTP_FROM=Homing <no-reply@example.com>

# ---------------------------------------------------------------
# 4. GitHub OAuth 登录（可选）
# ---------------------------------------------------------------
# GitHub → Settings → Developer settings → OAuth Apps：
#   Homepage URL:               https://relay.example.com/account
#   Authorization callback URL: https://relay.example.com/v1/account/github/callback
HOMING_GITHUB_CLIENT_ID=
HOMING_GITHUB_CLIENT_SECRET=

# ---------------------------------------------------------------
# 5. Android 离线唤醒（可选）
# ---------------------------------------------------------------
# Firebase 服务账号 JSON 路径；国内服务器没有 FCM 时留空即可。
HOMING_FCM_CREDENTIALS=
