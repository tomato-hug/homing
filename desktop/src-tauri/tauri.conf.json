{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Homing",
  "version": "0.7.0",
  "identifier": "dev.homing.desktop",
  "build": {
    "frontendDist": "../assets"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["binaries/*"],
    "copyright": "Homing",
    "category": "DeveloperTool",
    "shortDescription": "每个 agent 的回复，都能飞回你手里",
    "longDescription": "Homing 把 Codex、Claude Code、WorkBuddy、OpenCode、ZCode 的会话统一推到手机，可以在手机上直接回复。桌面端提供本机控制台、托盘提醒与配对。",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "dmg": {
        "appPosition": { "x": 180, "y": 170 },
        "applicationFolderPosition": { "x": 480, "y": 170 },
        "windowSize": { "width": 660, "height": 400 }
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
